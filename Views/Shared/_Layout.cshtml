<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TecnoHogar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;500;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar-premium">
        <div class="nav-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-house-gear-fill"></i></span>
                <span class="brand-text">Tecno<strong>Hogar</strong> <small>Portal Técnico</small></span>
            </a>
            <div class="nav-links">
                <a class="nav-link-custom" asp-controller="Home" asp-action="Index"><i class="bi bi-grid"></i> Inicio</a>
                <a class="nav-link-custom" asp-controller="Solicitudes" asp-action="Crear"><i class="bi bi-plus-circle"></i> Nueva Solicitud</a>
                <a class="nav-link-custom btn-nav" asp-controller="Solicitudes" asp-action="Index"><i class="bi bi-list-ul"></i> Ver Solicitudes</a>
            </div>
            <button class="nav-toggle" onclick="document.querySelector('.nav-links').classList.toggle('open')"><i class="bi bi-list"></i></button>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer-premium">
        <div class="footer-grid">
            <div><h4><i class="bi bi-house-gear"></i> TecnoHogar</h4><p>Instalación, mantenimiento y emergencias para tu hogar. Gestión interna sin papel.</p></div>
            <div><h5>Evaluación</h5><p>EC1 - 2026-2<br/>NET 10 MVC + EF Core + SQLite<br/>Render + GitHub Flow</p></div>
            <div><h5>Enlaces</h5><p><a href="/Solicitudes/Crear">Registrar</a> • <a href="/Solicitudes">Listar</a><br/>SQLite: tecnogas.db</p></div>
        </div>
        <div class="footer-bottom">© 2026 TecnoHogar — Hecho con <i class="bi bi-heart-fill" style="color:#ff5a60"></i> para la EC1 | <span class="mono">evaluacion20262</span></div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>AOS.init({ duration: 700, once: true });</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
